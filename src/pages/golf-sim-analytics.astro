---
import BaseLayout from "../layouts/BaseLayout.astro";
import Screenshot from "../components/Screenshot.astro";
import JsonLd from "../components/JsonLd.astro";
import {
  LATEST_DOWNLOAD_URL,
  PRODUCT_NAME,
  PRODUCT_OS,
  PRODUCT_PRICE,
  SITE_URL,
} from "../consts";

const title = "Golf Sim Analytics";
const description = `${PRODUCT_NAME} is a free Windows app for GSPro, zero-click capture, 15 interactive dashboards, live rounds, speed training, and unlimited local history. Free, open source, no account.`;

// What a manual-entry phone app can't do, the sim-rig exclusives.
const simOnly = [
  {
    title: "Live rounds",
    body: "Shots stream onto a live dispersion chart, then the round archives itself.",
    icon: "M2 12h4l3-8 4 16 3-8h6",
  },
  {
    title: "Automatic scorecards",
    body: "Every round scored hole-by-hole. You never type a number.",
    icon: "M4 22V4c4-2 8 2 12 0v12c-4 2-8-2-12 0",
  },
  {
    title: "Speed training",
    body: "Cruising speed, fatigue curve and progression across every session.",
    icon: "m12 14 4-4M3.34 19a10 10 0 1 1 17.32 0",
  },
  {
    title: "A golfer each",
    body: "Everyone in the house gets their own history. On-course rounds sort themselves out per shot.",
    icon: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8m13 14v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
  },
];

// Local-first guarantees, the "your data, your rules" grid.
const dataRules = [
  {
    title: "Local Parquet files",
    body: "Every shot lives on your PC. No cloud, no account, works offline.",
  },
  {
    title: "Reversible edits",
    body: "Edits store as sidecars. Your archived data is never touched.",
  },
  {
    title: "Yours after uninstall",
    body: "Uninstalling leaves your entire shot history on disk.",
  },
  {
    title: "Honest install",
    body: "The installer is unsigned, so Windows shows a one-time SmartScreen caution.",
  },
];

// The six categories, each paired with the dashboard screenshot it produces.
const dashboards = [
  {
    cat: "Metrics",
    stat: "6 dashboards",
    title: "Know every number",
    items: "Dispersion · Trajectory · Club Gapping · Swing Efficiency · Shot Quality · Session Stats",
    img: "/images/screenshots/dispersion.jpg",
    alt: "Dispersion dashboard plotting shot landing positions with left-right and carry scatter, colored by club, over per-club density contours.",
  },
  {
    cat: "Optimization",
    stat: "3 dashboards",
    title: "Dial it in",
    items: "Launch & Spin · Session Comparison · Shot Shape",
    img: "/images/screenshots/trajectory.jpg",
    alt: "Trajectory dashboard showing flight paths for every club with launch angle, peak height, and descent angle box plots flagged against ideal windows.",
  },
  {
    cat: "Club Fitting",
    stat: "A/B · live",
    title: "Test before you buy",
    items: "Compare shafts and adapter settings head-to-head with live shot capture, and let the dispersion decide.",
    img: "/images/screenshots/gapping_benchmarks.jpg",
    alt: "Club gapping chart with per-club carry density curves and rows of raw shots, overlaid with even-gap targets and PGA Tour benchmark markers to reveal distance gaps.",
  },
  {
    cat: "Speed Training",
    stat: "3 views",
    title: "Find free speed",
    items: "Cruising speed · Fatigue curve · Long-term progression",
    img: "/images/screenshots/speed_training.jpg",
    alt: "Speed training dashboard tracking club head speed across sessions with cruising speed, fatigue curve, and long-term progression views.",
  },
  {
    cat: "On-Course",
    stat: "Automatic",
    title: "Every round, scored",
    items: "Scorecards build themselves from your rounds, no manual entry.",
    img: "/images/screenshots/on_course.jpg",
    alt: "On-course dashboard showing automatically built scorecards with hole-by-hole scores from simulator rounds.",
  },
  {
    cat: "Live",
    stat: "Real-time",
    title: "Watch it happen",
    items: "A dispersion plot that updates shot by shot as you hit.",
    img: "/images/screenshots/live.jpg",
    alt: "Live session dashboard with a dispersion plot updating in real time as shots are hit.",
  },
];

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: PRODUCT_NAME,
  applicationCategory: "SportsApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: "latest",
  downloadUrl: LATEST_DOWNLOAD_URL,
  url: `${SITE_URL}/golf-sim-analytics`,
  description,
  offers: { "@type": "Offer", price: PRODUCT_PRICE, priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "OpenGolfLab", url: SITE_URL },
};
---

<BaseLayout title={title} description={description}>
  <JsonLd slot="head" data={softwareLd} />

  <!-- ============================ HERO ============================ -->
  <section class="app-hero">
    <div class="container app-hero-inner">
      <div class="app-hero-copy">
        <h1>Golf Sim Analytics</h1>
        <p class="lede" style="margin-top:1.1rem;">
          Every GSPro session, turned into analytics automatically. No CSV
          imports or exports.
        </p>
        <div class="hero-cta">
          <a href={LATEST_DOWNLOAD_URL} class="btn btn-primary btn-lg" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
            Download for Windows
          </a>
          <a href="/golf-sim-analytics/guide" class="btn btn-secondary btn-lg">Read the user guide</a>
        </div>
        {/* The five icon chips that sat here restated the free-note below and
            the feature sections further down. The screenshot does the work. */}
        <p class="app-free-note">
          Free · {PRODUCT_OS} · Open source · <a href="/download">Install guide &amp; FAQ</a>
        </p>
      </div>
    </div>
  </section>

  <section class="container app-hero-shot">
    <Screenshot
      src="/images/screenshots/home.jpg"
      alt="Golf Sim Analytics home dashboard showing metric tiles summarizing historical sessions, with carry distances, a dispersion plot, and per-club metrics."
      loading="eager"
      width={2000}
      height={1194}
      caption="The home dashboard, headline metrics across your session history."
    />
  </section>

  {/* "Three core features" lived here. Historical tracking and live logging
      are both shown in the dashboard grid below, and community contribution
      has its own section further down — so it was a third telling. */}

  <!-- ==================== DASHBOARDS (killer tiles) ==================== -->
  <section class="section">
    <div class="container">
      <h2>15 dashboards across six areas</h2>
      <p class="lede" style="margin-top:0.75rem;max-width:60ch;">
        GSPro shows you the shot. These show you your game.
      </p>

      <div class="dash-grid">
        {
          dashboards.map((d) => (
            <article class="card dash">
              <div class="dash-shot">
                <img src={d.img} alt={d.alt} width="2000" height="1194" loading="lazy" decoding="async" />
              </div>
              <div class="dash-top">
                <span class="dash-cat">{d.cat}</span>
                <span class="dash-stat tnum">{d.stat}</span>
              </div>
              <h3>{d.title}</h3>
              <p class="text-muted">{d.items}</p>
            </article>
          ))
        }
      </div>

      <p class="bench-note text-muted">
        And yes, one click overlays PGA Tour averages or any 5–20 handicap
        benchmark on your own numbers. The
        <a href="/golf-sim-analytics/guide#dashboards">user guide</a> covers
        every dashboard — what it measures, why it's there, and how to read it.
      </p>
    </div>
  </section>

  <!-- ======================= FITTING BAY ======================= -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="fitbay card">
        <div class="fitbay-copy">
          <p class="eyebrow">Club fitting</p>
          <h2>A free fitting bay in your garage</h2>
          <p class="text-muted" style="margin-top:0.85rem;max-width:54ch;">
            Two shafts, two settings, captured live and plotted against each
            other. The dispersion makes the call before your wallet does.
          </p>
          <div class="hero-cta">
            <a href="/gear" class="btn btn-secondary">Open the Gear Guide</a>
            <a href="/lab/community" class="btn btn-secondary">Community data ↗</a>
          </div>
        </div>
        <div class="fitbay-shot">
          <!-- TODO: swap in a dedicated fitting-bay (club_compare) screenshot when available -->
          <img
            src="/images/screenshots/dispersion.jpg"
            alt="Dispersion chart comparing shot patterns, the view used to judge two club configurations head-to-head."
            width="2000"
            height="1194"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= EFFORT ANALYSIS ======================= -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="fitbay card">
        <div class="fitbay-copy">
          <p class="eyebrow">Effort analysis</p>
          <h2>What does swinging harder actually cost you?</h2>
          <p class="text-muted" style="margin-top:0.85rem;max-width:54ch;">
            Every shot is scored as a percentage of your max speed with that
            club, then split into your easiest, middle and hardest thirds.
            One ring per band — each holding 80% of its shots — shows what
            going after one buys in carry and costs in dispersion. The
            answer is usually not what you'd guess, and now it's measured.
          </p>
          <div class="hero-cta">
            <a href="/golf-sim-analytics/guide#dashboards" class="btn btn-secondary">How to read it</a>
          </div>
        </div>
        <div class="fitbay-shot">
          <img
            src="/images/screenshots/effort_bands.jpg"
            alt="Dispersion chart comparing driver shots by swing effort: three rings for the easiest, middle and hardest thirds of swings, the hardest sitting longer at nearly the same width."
            width="2000"
            height="1194"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ONLY POSSIBLE IN A SIM ==================== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Only possible in a sim</p>
      <h2>Analytics a phone app can't reach</h2>
      <p class="lede" style="margin-top:0.75rem;max-width:62ch;">
        Manual-entry apps top out at a few typed-in shots. Your rig produces
        hundreds a session, captured automatically.
      </p>
      <ul class="features simonly">
        {
          simOnly.map((f) => (
            <li class="feature card">
              <svg class="feature-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d={f.icon}
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <h3>{f.title}</h3>
              <p class="text-muted">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== YOUR DATA, YOUR RULES ===================== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Local-first</p>
      <h2>Your data, your rules</h2>
      <ul class="features rules">
        {
          dataRules.map((r) => (
            <li class="feature card">
              <h3>{r.title}</h3>
              <p class="text-muted">{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PART OF SOMETHING BIGGER ===================== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="app-lab card">
        <div class="app-lab-inner">
          <h2>A practice tool that can also be a research instrument</h2>
          <p class="lede" style="margin-top:0.75rem;">
            Capture shots for yourself, and if you choose, help build the open
            dataset in <a href="/lab">the Lab</a>.
          </p>
          <div class="hero-cta">
            <a href="/lab" class="btn btn-secondary">See the mission</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= FINAL CTA ========================= -->
  <section class="section-tight">
    <div class="container final-cta">
      <h2>Start with your very next session</h2>
      <p class="lede mx-auto" style="margin-top:0.6rem;">
        Install it, play, and watch your numbers show up.
      </p>
      <div class="hero-cta" style="justify-content:center;">
        <a href={LATEST_DOWNLOAD_URL} class="btn btn-primary btn-lg" rel="noopener">Download for Windows</a>
        <a href="/download" class="btn btn-secondary btn-lg">System requirements</a>
      </div>
      <p class="sample-note text-muted">
        No sim yet? Install anyway, ⚙ Settings → “Use sample data” loads two
        bundled datasets to explore every dashboard.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .app-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: radial-gradient(110% 90% at 20% -10%, var(--green-tint), transparent 60%);
  }
  .app-hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(1.5rem, 4vw, 2.75rem);
  }
  .app-hero-copy {
    max-width: 62ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  .app-free-note {
    margin-top: 1.1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-dim);
  }
  .app-hero-shot {
    margin-top: -1.5rem;
    position: relative;
    z-index: 2;
  }

  /* Dashboard tiles, each headed by its own screenshot */
  .dash-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .dash {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .dash:hover {
    border-color: var(--green-dim);
    transform: translateY(-2px);
  }
  .dash-shot {
    margin: -0.75rem -0.5rem 0.6rem;
    border: 1px solid var(--border-strong);
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .dash-shot img {
    width: 100%;
    height: auto;
    display: block;
  }
  .dash-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }
  .dash-cat {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--green);
    font-weight: 600;
  }
  .dash-stat {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .dash h3 {
    font-size: 1.2rem;
  }

  /* Three core features */
  .features {
    margin-top: 2rem;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .feature-icon {
    color: var(--green);
    margin-bottom: 0.4rem;
  }
  .feature h3 {
    font-size: 1.2rem;
  }

  .bench-note {
    margin-top: 1.4rem;
    font-size: 0.95rem;
  }

  /* Fitting bay split card */
  .fitbay {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }
  .fitbay-copy {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .fitbay-shot {
    position: relative;
    border-left: 1px solid var(--border);
    background: var(--bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
  }
  .fitbay-shot img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* Data-rules 2×2 grid */
  .rules {
    grid-template-columns: repeat(2, 1fr);
  }

  /* Four sim-only cards: 4-up rather than 3-up, so the fourth doesn't sit
     alone on its own row. Falls back to the shared 2-up / 1-up breakpoints. */
  .simonly {
    grid-template-columns: repeat(4, 1fr);
  }

  .sample-note {
    margin-top: 1.1rem;
    font-size: 0.95rem;
  }

  .app-lab {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: linear-gradient(135deg, var(--surface) 0%, var(--bg-elevated) 100%);
  }
  .app-lab-inner {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }

  .final-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 900px) {
    .dash-grid,
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
    .fitbay {
      grid-template-columns: 1fr;
    }
    .fitbay-shot {
      border-left: none;
      border-top: 1px solid var(--border);
      min-height: 220px;
      order: -1;
    }
  }
  @media (max-width: 680px) {
    .dash-grid,
    .features,
    .rules {
      grid-template-columns: 1fr;
    }
  }
</style>
