---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PRODUCT_NAME, KOFI_URL, GITHUB_URL } from "../consts";
import { loadMarket, loadBallMarket, loadCommunity } from "../lib/lab";

// Real counts, computed at build from the lineup datasets. No slogans.
const market = loadMarket();
const balls = loadBallMarket();
const community = loadCommunity();

// Three things, three tiles, one line each. The full story lives on each
// page — the home page's job is to say what exists and get out of the way.
const pillars = [
  {
    href: "/golf-sim-analytics",
    label: PRODUCT_NAME,
    stat: "Free · Windows · 15 dashboards",
    blurb:
      "Plugs into GSPro and logs every shot on its own. Nothing to export.",
  },
  {
    href: "/lab",
    label: "Community Data",
    stat: community.hasCommunityData
      ? `${community.totalContributors} golfers · ${community.totalShots.toLocaleString()} shots`
      : "Collecting first dataset",
    blurb:
      "Share your shots, anonymized, and see how you stack up against real golfers.",
  },
  {
    href: "/gear",
    label: "Gear Guide",
    stat: market.hasLineups
      ? `${market.modelCount} drivers · ${balls.hasLineups ? `${balls.modelCount} balls · ` : ""}irons · wedges`
      : "Not published yet",
    blurb:
      "Every driver, iron, wedge and ball mapped by what it does, at today's prices.",
  },
];

// The questions pooled indoor data can settle and nothing else can. These
// are the pitch — they don't need a paragraph introducing them.
const questions = [
  "What does a premium ball actually buy you?",
  "What do real gaps look like at your handicap?",
  "How do launch monitors truly compare?",
  "What does a 2020 driver give up to a 2026?",
];
---

<BaseLayout>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset="/images/course_bg-mobile.jpg" />
        <img
          src="/images/course_bg.jpg"
          alt=""
          width="2400"
          height="1350"
          fetchpriority="high"
        />
      </picture>
      <div class="hero-scrim"></div>
    </div>

    <div class="container hero-inner">
      <h1 class="hero-title">Your sim is the lab. Your swings are the data.</h1>
      <p class="lede hero-lede">
        Free GSPro analytics, and a growing dataset of real amateur shots.
      </p>

      <div class="hero-cta">
        <a href="/download" class="btn btn-primary btn-lg">Download the free app</a>
        <a href="/lab" class="btn btn-secondary btn-lg">Preview the Lab</a>
      </div>
    </div>
  </section>

  <!-- ==================== THE BIG THREE ==================== -->
  <section class="section">
    <div class="container">
      <div class="lab-tiles">
        {
          pillars.map((t) => (
            <a href={t.href} class="card lab-tile">
              <h2 class="lab-tile-title">{t.label}</h2>
              <p class="lab-tile-stat tnum">{t.stat}</p>
              <p class="lab-tile-blurb">{t.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== THE APP, SHOWN NOT TOLD ==================== -->
  <section class="section">
    <div class="container">
      <h2>Every shot, analyzed automatically</h2>
      <figure class="figure shot-figure">
        <img
          src="/images/screenshots/dispersion.jpg"
          alt="Golf Sim Analytics dispersion dashboard plotting shot landing positions by club against an ideal target ellipse."
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Dispersion by club, built from shots as you hit them.</figcaption>
      </figure>
      <div class="hero-cta">
        <a href="/golf-sim-analytics" class="btn btn-secondary">Explore the app</a>
      </div>
    </div>
  </section>

  <!-- ==================== COMMUNITY DATA ==================== -->
  <section class="section">
    <div class="container">
      <h2>Answer what nobody else can</h2>
      <p class="lede">
        A sim bay is a controlled lab. Pooled indoor shots settle questions
        tour stats and robot testing can't.
      </p>
      <ul class="q-list">
        {questions.map((q) => <li class="card q-item">{q}</li>)}
      </ul>
      <div class="hero-cta">
        <a href="/lab" class="btn btn-secondary">See how the Lab works</a>
        <a href="/lab#methodology" class="source-link">How the data is collected</a>
      </div>
    </div>
  </section>

  <!-- ==================== CLOSING ==================== -->
  <section class="section-tight">
    <div class="container">
      <div class="openfree">
        <h2>Independent and community-driven.</h2>
        <p class="lede mx-auto" style="text-align:center;margin-top:0.8rem;">
          Built in the open. The data belongs to the community.
        </p>
        <div class="hero-cta" style="justify-content:center;">
          <a href={KOFI_URL} class="btn btn-coffee" rel="noopener" target="_blank">Fuel the Lab</a>
          <a href={GITHUB_URL} class="btn btn-secondary" rel="noopener" target="_blank">Watch on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  /* Flat scrim, no green glow — the photo just has to keep the type legible. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--bg-translucent) 0%,
      rgba(20, 19, 17, 0.86) 60%,
      var(--bg) 100%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-title {
    max-width: 20ch;
  }
  .hero-lede {
    margin-top: 1.2rem;
    text-align: center;
    color: var(--text-muted);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.8rem;
    justify-content: center;
  }

  /* ---- The big three tiles ---- */
  .lab-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    align-items: stretch;
  }
  .lab-tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
  }
  .lab-tile-title {
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
  }
  .lab-tile-stat {
    color: var(--green);
  }
  .lab-tile-blurb {
    color: var(--text-muted);
  }

  /* ---- App screenshot ---- */
  .shot-figure {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .shot-figure img {
    width: 100%;
    height: auto;
  }
  .shot-figure figcaption {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--border);
  }

  /* ---- Community questions ---- */
  .q-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  .q-item {
    color: var(--text);
    padding: 1.1rem 1.25rem;
  }

  /* ---- Closing callout ---- */
  .openfree {
    border: 1px solid var(--border);
    padding: clamp(1.75rem, 4vw, 3rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
  }

  .hero-cta:has(.source-link) {
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .lab-tiles,
    .q-list {
      grid-template-columns: 1fr;
    }
  }
</style>
