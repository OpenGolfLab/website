<BaseLayout title={title} description={description}>
  <section class="section-tight lab-hero">
    <div class="container lab-hero-inner">
      <h1>Gear Guide</h1>
      <p class="lede" style="margin-top:1rem;">
        Every club and ball, mapped by what it does and what it costs today.
      </p>
      {
        hasLineups && (
          <p class="lab-stat-line tnum">
            {modelCount} drivers
            {balls.hasLineups && <>{" "}· {balls.modelCount} balls</>}
            {irons.hasLineups && <>{" "}· {irons.modelCount} iron sets</>}
            {wedges.hasLineups && <>{" "}· {wedges.modelCount} wedges</>}
          </p>
        )
      }
    </div>
  </section>

  <GearNav />

  <div class="container lab-body">
    {/* Applies to every chart on the page, so it leads. */}
    {hasLineups && <FocusFilter />}
    {
      hasLineups ? (
        <>
          {/* ---- Driver spectrum ---- */}
          <section class="lab-band" id="drivers">
            <div class="lab-band-head">
              <h2 id="lineups">2026 Driver Lineup Spectrum</h2>
              <p class="text-muted" style="max-width:66ch;">
                Every current driver, placed from maximum forgiveness to pure
                distance.
              </p>
            </div>

            <div class="continuum-wrap" role="region" aria-label="2026 driver continuum">
              <div class="continuum-header">
                <span>Max Forgiveness</span>
                <span class="text-dim">Balanced / Core</span>
                <span>Pure Distance</span>
              </div>

              <div class="continuum-body">
                {spectrumLineups.map((lineup: any) => (
                  <div class="continuum-row">
                    <div class="continuum-brand">
                      <strong>{lineup.brand}</strong>
                    </div>
                    <div class="continuum-track-area">
                      <div class="continuum-track-line" aria-hidden="true" />
                      {[0, 25, 50, 75, 100].map((tick) => (
                        <span class="continuum-gridline" style={`left:${tick}%`} aria-hidden="true" />
                      ))}
                      {/* Starting-point band, one per player bucket. Positions
                          are already percentages here, so unlike the quadrant
                          maps this needs no projection. */}
                      {FOCUS_KEYS.map((key) => {
                        const [lo, hi] = driverRange(key);
                        return (
                          <span
                            class="continuum-focus"
                            data-focus-key={key}
                            style={`left:${lo}%; width:${hi - lo}%;`}
                            aria-hidden="true"
                          />
                        );
                      })}
                      {lineup.models.map((model: any) => (
                        <div
                          class="continuum-node"
                          style={`left: ${model.position}%; --stagger: ${model.stagger};`}
                        >
                          <span class="continuum-node-dot" aria-hidden="true" />
                          <span class="continuum-node-label">{model.name}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <MobileLineupList
              lineups={driverMobileLineups}
              legend="Position 0–100: max forgiveness → pure distance"
            />

            <p class="lab-caption">
              <a class="source-link" href="/lab#gear-sourcing">How placements are researched</a>
            </p>

            {/* The rule of thumb as a figure: three bands running left to right
                in the same order as the spectrum above, so your dispersion
                number points straight at the half of it you should shop. */}
            <figure class="figure fit-figure">
              <p class="fit-figure-title">Your dispersion picks your half</p>
              <div class="fit-bands">
                <div class="fit-band">
                  <span class="fit-band-num tnum">±25 yd +</span>
                  <span class="fit-band-where">Max forgiveness</span>
                </div>
                <div class="fit-band">
                  <span class="fit-band-num tnum">±18–25 yd</span>
                  <span class="fit-band-where">Balanced core</span>
                </div>
                <div class="fit-band">
                  <span class="fit-band-num tnum">under ±18 yd</span>
                  <span class="fit-band-where">Distance end</span>
                </div>
              </div>
              <figcaption>
                Measure yours over 30+ shots in the
                <a href="/golf-sim-analytics">dispersion dashboard</a>.
              </figcaption>
            </figure>
          </section>

          {/* ---- Pricing ---- */}
          <section class="lab-band">
            <div class="lab-band-head">
              <h2 id="pricing">Driver Pricing</h2>
              <p class="text-muted" style="max-width:66ch;">
                Hollow dot = MSRP. Filled dot = today's best price. Click a row
                to shop.
              </p>
              <p class="lab-stat-line tnum">
                {modelCount} drivers · median street price ${medianPrice}
                {biggestDiscount && (
                  <>
                    {" "}· biggest discount: {biggestDiscount.name} −
                    {Math.round(biggestDiscount.pct)}%
                  </>
                )}
              </p>
            </div>

            <PriceChart
              models={pricingRanked}
              axisTicks={axisTicks}
              axisMaxRounded={axisMaxRounded}
              ariaLabel="Driver street prices, most expensive first"
            />

            <p class="lab-caption">
              <a class="source-link" href="/lab#gear-sourcing">How prices are tracked</a>
            </p>
          </section>

          {/* ---- Iron map (quadrant plot) ---- */}
          {irons.hasLineups && ironMap && (
            <section class="lab-band" id="irons">
              <div class="lab-band-head">
                <h2 id="iron-map">2026 Iron Map</h2>
                <p class="text-muted" style="max-width:66ch;">
                  Help from the head (right = less) against what's really
                  stamped on the 7-iron (up = stronger). Those lofts span 27°
                  to 35° — a two-club difference — so the vertical axis is your
                  loft-jacking check. Hover any dot.
                </p>
              </div>

              <QuadrantMap
                focus={ironMap.focus}
                map={ironMap}
                regionLabel="2026 iron map"
                svgLabel="Scatter plot of iron models with forgiveness decreasing left to right and 7-iron loft getting stronger bottom to top. Strong-lofted game-improvement irons sit top left; players distance irons top right; blades and traditional cavity backs bottom right."
                xCaption={`← More forgiving · More workable →`}
                yCaption={`← Traditional loft · Stronger loft →`}
                legend={Object.values(IRON_CATS).map((c) => ({ cls: c.cls, label: `${c.label.toLowerCase()}, ${c.blurb}` }))}
              />

              <MobileLineupList
                lineups={ironMobileLineups}
                legend="Position 0–100: max help → compact precision"
              />

              <p class="lab-caption">
                <a class="source-link" href="/lab#gear-sourcing">How placements are researched</a>
              </p>

              {/* Which quadrant are you? */}
              <div class="ball-profiles">
                {ironProfiles.map((p) => (
                  <div class="card ball-profile">
                    <span class="ball-profile-tag">{p.tag}</span>
                    <h3>{p.title}</h3>
                    <p class="text-muted">{p.body}</p>
                    <p class="ball-profile-picks tnum">{p.quadrant}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* ---- Iron pricing ---- */}
          {irons.hasLineups && (
            <section class="lab-band">
              <div class="lab-band-head">
                <h2 id="iron-pricing">Iron Pricing, per set, as sold</h2>
                <p class="text-muted" style="max-width:66ch;">
                  Set makeups vary — hover a row for the exact configuration
                  behind the number.
                </p>
                <p class="lab-stat-line tnum">
                  {irons.modelCount} iron sets · median ${irons.medianPrice}
                  {irons.biggestDiscount && (
                    <>
                      {" "}· biggest discount: {irons.biggestDiscount.name} −
                      {Math.round(irons.biggestDiscount.pct)}%
                    </>
                  )}
                </p>
              </div>

              <PriceChart
                models={irons.pricingRanked}
                axisTicks={irons.axisTicks}
                axisMaxRounded={irons.axisMaxRounded}
                ariaLabel="Iron set street prices, most expensive first"
                titleFor={(brand: string, model: any) => `${brand} ${model.name}, ${model.config}`}
              />

              <p class="lab-caption">
                Graphite shafts typically add $100–200.
                <a class="source-link" href="/lab#gear-sourcing">How prices are tracked</a>
              </p>
            </section>
          )}

          {/* ---- Wedge map (quadrant plot) ---- */}
          {wedges.hasLineups && wedgeMap && (
            <section class="lab-band" id="wedges">
              <div class="lab-band-head">
                <h2 id="wedge-map">2026 Wedge Map</h2>
                <p class="text-muted" style="max-width:66ch;">
                  Forgiveness (right = less) against bounce (up = more). Too
                  little bounce digs on soft turf; too much skips off tight
                  lies. Hover any dot.
                </p>
              </div>

              <QuadrantMap
                map={wedgeMap}
                regionLabel="2026 wedge map"
                svgLabel="Scatter plot of wedge models with forgiveness decreasing left to right and sole bounce increasing bottom to top. Forgiving cavity wedges sit left; tour blades right; high-bounce soft-turf wedges toward the top and low-bounce firm-turf wedges toward the bottom."
                xCaption={`← More forgiving · More workable →`}
                yCaption={`← Low bounce · High bounce →`}
                legend={Object.values(WEDGE_CATS).map((c) => ({ cls: c.cls, label: `${c.label.toLowerCase()}, ${c.blurb}` }))}
              />

              <MobileLineupList
                lineups={wedgeMobileLineups}
                legend="Position 0–100: forgiving cavity → tour blade"
              />

              <p class="lab-caption">
                Plotted at each model's 56° bounce.
                <a class="source-link" href="/lab#gear-sourcing">How placements are researched</a>
              </p>

              {/* Which quadrant are you? */}
              <div class="ball-profiles">
                {wedgeProfiles.map((p) => (
                  <div class="card ball-profile">
                    <span class="ball-profile-tag">{p.tag}</span>
                    <h3>{p.title}</h3>
                    <p class="text-muted">{p.body}</p>
                    <p class="ball-profile-picks tnum">{p.quadrant}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* ---- Wedge pricing ---- */}
          {wedges.hasLineups && (
            <section class="lab-band">
              <div class="lab-band-head">
                <h2 id="wedge-pricing">Wedge Pricing, per wedge</h2>
                <p class="text-muted" style="max-width:66ch;">
                  One head at a time. Hover a row for its bounce and grind.
                </p>
                <p class="lab-stat-line tnum">
                  {wedges.modelCount} wedges · median ${wedges.medianPrice}
                  {wedges.biggestDiscount && (
                    <>
                      {" "}· biggest discount: {wedges.biggestDiscount.name} −
                      {Math.round(wedges.biggestDiscount.pct)}%
                    </>
                  )}
                </p>
              </div>

              <PriceChart
                models={wedges.pricingRanked}
                axisTicks={wedges.axisTicks}
                axisMaxRounded={wedges.axisMaxRounded}
                ariaLabel="Wedge street prices, most expensive first"
                titleFor={(brand: string, model: any) => `${brand} ${model.name}, ${model.bounce}° bounce, ${model.grind}`}
              />

              <p class="lab-caption">
                Premium finishes and custom grinds add cost.
                <a class="source-link" href="/lab#gear-sourcing">How prices are tracked</a>
              </p>
            </section>
          )}

          {/* ---- Golf ball map (quadrant plot) ---- */}
          {balls.hasLineups && ballMap && (
            <section class="lab-band" id="balls">
              <div class="lab-band-head">
                <h2 id="ball-map">2026 Golf Ball Map</h2>
                <p class="text-muted" style="max-width:66ch;">
                  Spin (right = less) against firmness (up = firmer, for faster
                  swings). Find your quadrant below, then shop the dots in it.
                </p>
              </div>

              <QuadrantMap
                focus={ballMap.focus}
                map={ballMap}
                regionLabel="2026 golf ball map"
                svgLabel="Scatter plot of golf balls with spin decreasing left to right and compression increasing bottom to top. Firm low-spin distance balls sit top right; soft straight-flying balls sit bottom right; firm tour balls sit top left."
                xCaption={`← More spin · Straighter →`}
                yCaption={`← Softer · Firmer →`}
                legend={[
                  { cls: "premium", label: "urethane cover, grippier, so naturally more spin: greenside control" },
                  { cls: "value", label: "ionomer / hybrid cover, less grippy, so naturally lower spin: distance & budget" },
                ]}
              />

              <MobileLineupList
                lineups={ballMobileLineups}
                legend="Position 0–100: low spin → tour spin"
              />

              <p class="lab-caption">
                <a class="source-link" href="/lab#gear-sourcing">How placements are researched</a>
              </p>

              {/* Which quadrant are you? */}
              <div class="ball-profiles">
                {ballProfiles.map((p) => (
                  <div class="card ball-profile">
                    <span class="ball-profile-tag">{p.tag}</span>
                    <h3>{p.title}</h3>
                    <p class="text-muted">{p.body}</p>
                    <p class="ball-profile-picks tnum">{p.quadrant}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* ---- Ball pricing ---- */}
          {balls.hasLineups && (
            <section class="lab-band">
              <div class="lab-band-head">
                <h2 id="ball-pricing">Ball Pricing, per dozen</h2>
                <p class="text-muted" style="max-width:66ch;">
                  Hollow dot = MSRP. Filled dot = today's best price.
                </p>
                <p class="lab-stat-line tnum">
                  {balls.modelCount} balls · median ${balls.medianPrice}/dozen
                  {balls.biggestDiscount && (
                    <>
                      {" "}· biggest discount: {balls.biggestDiscount.name} −
                      {Math.round(balls.biggestDiscount.pct)}%
                    </>
                  )}
                </p>
              </div>

              <PriceChart
                models={balls.pricingRanked}
                axisTicks={balls.axisTicks}
                axisMaxRounded={balls.axisMaxRounded}
                ariaLabel="Ball street prices per dozen, most expensive first"
                priceSuffix="/dz"
              />

              <p class="lab-caption">
                Bulk and subscription deals can run lower.
                <a class="source-link" href="/lab#gear-sourcing">How prices are tracked</a>
              </p>
            </section>
          )}

        </>
      ) : (
        <section class="lab-band">
          <p class="tier-empty">Gear data isn't published yet.</p>
        </section>
      )
    }

    {/* ---- What's coming to this section ---- */}
    <section class="lab-band">
      <div class="lab-band-head">
        <h2>Coming to the Gear Guide</h2>
        <p class="text-muted" style="max-width:66ch;">
          The rest of the bag gets the same treatment. See the
          <a href="/lab#roadmap">roadmap</a>.
        </p>
      </div>

      <div class="lab-planned-grid">
        <div class="lab-planned">
          <div class="lab-planned-head">
            <h3>Fairway woods &amp; hybrids</h3>
            <span class="pill lab-planned-pill">Planned</span>
          </div>
          <p>Mapped from forgiveness to speed, priced like the rest.</p>
        </div>
        <div class="lab-planned">
          <div class="lab-planned-head">
            <h3>Putters</h3>
            <span class="pill lab-planned-pill">Planned</span>
          </div>
          <p>Head style, hosel and balance, matched to your stroke.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lab-planned-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap);
  }
  .tier-empty {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border: 1px dashed var(--border-strong);
    padding: 1rem 1.25rem;
    max-width: 560px;
  }

  /* ---- Continuum / spectrum ---- */
  .continuum-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.25rem 1.5rem 0.85rem;
    overflow-x: auto;
    max-width: 1000px;
  }
  .continuum-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-left: 140px;
    margin-bottom: 1.1rem;
  }
  .continuum-body {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    min-width: 560px;
  }
  .continuum-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .continuum-brand {
    width: 116px;
    flex-shrink: 0;
    color: var(--green);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
  }
  .continuum-track-area {
    flex-grow: 1;
    position: relative;
    height: 34px;
  }
  .continuum-track-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border-strong);
    transform: translateY(-50%);
  }
  .continuum-gridline {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 1px;
    background: var(--border);
    opacity: 0.6;
  }
  /* Starting-point band. Sits behind the nodes (z-index 2) so model dots and
     labels stay fully legible on top of the shading. */
  .continuum-focus {
    position: absolute;
    top: -6px;
    bottom: -6px;
    z-index: 1;
    background: var(--focus-fill, rgba(90, 160, 220, 0.14));
    border-inline: 1.5px dashed var(--focus-stroke, rgba(90, 160, 220, 0.55));
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    pointer-events: none;
  }
  .continuum-focus.is-active {
    opacity: 1;
  }
  .continuum-node {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
