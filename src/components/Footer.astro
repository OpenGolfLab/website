---
import Logo from "./Logo.astro";
import ContributorProgress from "./ContributorProgress.astro";
import { GITHUB_URL, SITE_TAGLINE } from "../consts";
const year = new Date().getFullYear();

// The home page runs the loud variant directly under its hero, so the footer
// copy would be the same strip twice on one page.
const onHome = Astro.url.pathname.replace(/\/$/, "") === "";
---

{/* The contributor count rides above the footer on every page: it's the one
    number the whole project is gated on, and it was only visible to people who
    already found /lab/community. */}
{!onHome && <ContributorProgress />}

<footer class="footer">
  {/* The old trust bar lived here: four claims in 12px mono on every page.
      The app-specific ones (local Parquet, reversible edits, uninstall safety)
      belong on /golf-sim-analytics and /privacy, where someone is actually
      asking the question. */}
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">{SITE_TAGLINE}</p>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <h4>Product</h4>
        <a href="/golf-sim-analytics">Golf Sim Analytics</a>
        <a href="/download">Download</a>
        <a href="/#why">Why we exist</a>
      </div>
      <div class="footer-col">
        <h4>Community</h4>
        <a href="/lab">The Lab</a>
        <a href="/blog">Blog</a>
        <a href="/rss.xml">RSS feed</a>
        <a href="/privacy">Data &amp; privacy</a>
      </div>
      <div class="footer-col">
        <h4>Project</h4>
        <a href={GITHUB_URL} rel="noopener" target="_blank">GitHub</a>
        <a href="https://gsprogolf.com/" rel="noopener" target="_blank">GSPro</a>
      </div>
    </nav>
  </div>

  <div class="container footer-base">
    <p>© {year} OpenGolfLab. Independent project, not affiliated with GSPro.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    margin-top: 2rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }
  .footer-tagline {
    margin-top: 0.9rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-dim);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .footer-col a {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .footer-col a:hover {
    color: var(--green);
  }
  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
