{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengolflab",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  // Keep the *.workers.dev URL enabled — it's what the desktop app fetches
  // (config.OPENGOLFLAB_COMMUNITY_URL). Adding custom-domain `routes` here
  // silently disabled it and, when the domain attach failed, left NO working
  // URL. Attaching opengolflab.com is being done from the Cloudflare dashboard
  // instead (it manages the DNS record + token scope that the CI deploy can't),
  // so this file stays workers.dev-only.
  "workers_dev": true,

  // Sink for the site's funnel counters (src/pages/api/e.ts). The dataset is
  // created on first write — nothing to provision in the dashboard. If this
  // account can't use Analytics Engine, deleting this block is safe: the
  // endpoint checks for the binding and no-ops without it.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "opengolflab_events"
    }
  ],

  // Feedback inbox (src/pages/api/feedback.ts) — bug reports and ideas from
  // the site's /feedback form and the desktop app's Send Feedback dialog.
  // Read it with:
  //   npx wrangler d1 execute opengolflab-feedback --remote \
  //     --command "SELECT ts, source, kind, message, contact FROM feedback ORDER BY ts DESC LIMIT 50"
  // Schema lives in db/feedback-schema.sql (idempotent; re-run it to migrate).
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "opengolflab-feedback",
      "database_id": "eddd2f7f-6ab6-46d2-abfc-968aa759377d"
    }
  ]
}
